# MusicalBOX SM: web editor (http://10.42.0.1 on the Pi's own Wi-Fi).
# Installed by system/install-services.sh (@USER@ and @DIR@ filled in there).
[Unit]
Description=MusicalBOX SM: web editor
After=mbx-engine.service network.target

[Service]
User=@USER@
SupplementaryGroups=gpio spi
WorkingDirectory=@DIR@
ExecStart=/usr/bin/python3 @DIR@/control/mbx_control.py --port 80 --config @DIR@/config
# Port 80 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Nice=5
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
