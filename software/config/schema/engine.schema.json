{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MusicalBOX SM engine.json",
  "description": "System parameters. Every field is optional; command-line options override them.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^_": {}
  },
  "required": [
    "version"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "device": {
          "type": "string",
          "default": "",
          "description": "part of the output device name (see mbx-engine --list-devices); empty = system default"
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 22050,
          "maximum": 192000,
          "default": 48000
        },
        "period_frames": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096,
          "default": 128,
          "description": "audio block: smaller = less latency, more CPU"
        },
        "periods": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "default": 3
        }
      }
    },
    "master_volume_db": {
      "type": "number",
      "minimum": -90,
      "maximum": 6,
      "default": -6,
      "description": "master volume at power on"
    },
    "polyphony": {
      "type": "integer",
      "minimum": 8,
      "maximum": 256,
      "default": 64,
      "description": "voices sounding at the same time; a note uses one voice per layer"
    },
    "max_layers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 3,
      "description": "instruments per program, stacked or split"
    },
    "ram_budget_percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 95,
      "default": 70,
      "description": "share of physical RAM for samples; 0 = no limit"
    },
    "midi_channel": {
      "oneOf": [
        {
          "const": "omni"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      ],
      "default": "omni"
    },
    "pitch_bend_range": {
      "type": "number",
      "minimum": 0,
      "maximum": 24,
      "default": 2,
      "description": "pitch bend range in semitones, up and down; 0 = pitch bend ignored"
    },
    "midi_serial": {
      "type": "string",
      "default": "/dev/serial0",
      "description": "serial port of the DIN MIDI input (needs dtoverlay=midi-uart0); empty = disabled. USB MIDI is always on"
    },
    "control_socket": {
      "type": "string",
      "default": "/tmp/mbx-engine.sock",
      "description": "local socket for mbx-control (web editor); empty = disabled"
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "description": "front panel, handled by mbx-control (BCM GPIO numbers; null = not connected)",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "fx_switch": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 27,
          "default": 23,
          "description": "effect switch footswitch (momentary), to GND"
        },
        "encoder": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 27
          },
          "minItems": 2,
          "maxItems": 2,
          "default": [
            5,
            6
          ],
          "description": "volume encoder pins A and B; turning changes the master volume (not saved)"
        },
        "volume_step_db": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 6,
          "default": 1,
          "description": "volume change per encoder step"
        },
        "status_led": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 27,
          "default": 24,
          "description": "status LED on its own GPIO (with resistor)"
        },
        "wifi_led": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 27,
          "default": null,
          "description": "Wi-Fi LED on a GPIO (with resistor), for a panel without the chain"
        },
        "wifi_at_boot": {
          "type": "boolean",
          "default": false,
          "description": "Wi-Fi at power on; false = off until the panel's wifi button is pressed"
        },
        "hotspot": {
          "type": "string",
          "default": "MusicalBOX-SM",
          "description": "NetworkManager connection of the box's own network"
        },
        "loading_timeout_s": {
          "type": "number",
          "minimum": 10,
          "default": 180,
          "description": "engine running this long without answering = error"
        },
        "chain": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^_": {}
          },
          "description": "buttons on 74HC165 and LEDs on 74HC595, on SPI with a shared latch",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "device": {
              "type": "string",
              "default": "/dev/spidev0.0"
            },
            "latch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 27,
              "default": 25,
              "description": "latch GPIO: 165 SH/LD and 595 RCLK"
            },
            "oe": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 27,
              "default": 12,
              "description": "595 output enable GPIO (with 10 kOhm pull-up): LEDs dark until the first write; PWM sets the brightness. null = OE wired to GND"
            },
            "brightness": {
              "type": "number",
              "minimum": 5,
              "maximum": 100,
              "default": 100,
              "description": "LED brightness, %"
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8,
              "default": 3,
              "description": "165 + 595 pairs: 8 buttons and 8 LEDs each"
            },
            "speed_hz": {
              "type": "integer",
              "minimum": 10000,
              "maximum": 4000000,
              "default": 500000
            },
            "buttons": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[1-9][0-9]?$": {
                  "type": "string",
                  "pattern": "^(ok|back|panic|switch|wifi|record|status|volume [+-]|preset [+-]|preset ([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
                }
              },
              "description": "button number -> action: ok, back, panic, switch, wifi, record, volume +/-, preset +/-, preset N. Default: 1 ok, 2 back, 3 panic, 4 wifi, 5-24 presets 1-20"
            },
            "leds": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^[1-9][0-9]?$": {
                  "type": "string"
                }
              },
              "description": "LED number -> what it shows (wifi, switch, record, status, preset N; \"\" = off). LED n shows button n's action unless set here"
            }
          }
        }
      }
    },
    "record_folder": {
      "type": "string",
      "default": "/tmp",
      "description": "folder of the recordings (r in the console, web editor); /tmp is in RAM on a read-only system"
    },
    "dac_mute": {
      "type": "object",
      "description": "mute pins (XSMT) of the two PCM5102A DACs: the program's output A / B / AB chooses which one sounds",
      "additionalProperties": false,
      "patternProperties": {
        "^_": {}
      },
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "false = the engine does not touch the GPIOs (XSMT bridged to 3V3 on the module)"
        },
        "a": {
          "type": "integer",
          "minimum": 0,
          "maximum": 53,
          "default": 16,
          "description": "BCM GPIO of DAC A's XSMT"
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 53,
          "default": 17,
          "description": "BCM GPIO of DAC B's XSMT"
        },
        "chip": {
          "type": "string",
          "default": "",
          "description": "GPIO chip (gpiochip0...); empty = the Raspberry Pi's own"
        }
      }
    }
  }
}
